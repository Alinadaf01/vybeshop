# dependencies
node_modules

# build output
dist
dist-ssr

# env
.env
.env.local

# editor
.vscode/*
!.vscode/extensions.json
.idea

# logs
*.log
npm-debug.log*

# os
.DS_Store
Thumbs.db

# typescript
*.tsbuildinfo

# playwright
/test-results/
/playwright-report/
/blob-report/
.claude/settings.local.json
.vercel
.env*
# Templates are meant to be committed — only the *filled-in* files (which
# .env* above already catches) should ever be gitignored.
!.env.example
!*/.env.example
!.env.production.example

# python / django backend
backend/.venv
backend/**/__pycache__
*.pyc
backend/staticfiles
backend/media
backend/db.sqlite3

# deploy (§8) — SSL certs and any local override of the prod compose file
certbot/

# deploy/setup.sh stages 5 & 7 — real database dumps, media tarballs, and
# backups are data, never repo content. The directories themselves stay
# tracked via .gitkeep.
deploy/incoming/*
!deploy/incoming/.gitkeep
deploy/backups/*
!deploy/backups/.gitkeep
deploy/backup.log
