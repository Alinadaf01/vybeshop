# Production environment template (§8 deploy prep) — copy to .env.production
# and fill in real values. Never commit the filled-in file. Read by
# docker-compose.prod.yml's `env_file:` on the web/celery-worker/celery-beat
# services. Every variable Django actually reads is listed here — see
# backend/config/settings.py for where each one is used.
#
# SMS (Kavenegar) and payment gateway (Zarinpal) credentials are NOT env
# vars — they're entered through the admin panel's Settings -> API Keys
# page after first deploy (stored encrypted in the database via
# apps.settings.ApiCredential). Nothing to set here for those.

# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Same generator, a second independent value — used only for signing JWTs,
# kept separate from SECRET_KEY so rotating one doesn't invalidate the other.
JWT_SIGNING_KEY=
DEBUG=False
# Option B (DEPLOY-TASK.md): only api./admin. resolve to this server — the
# storefront (vybeshop.ir, www) stays on Vercel and never reaches Django
# directly, so it doesn't belong in ALLOWED_HOSTS.
ALLOWED_HOSTS=api.vybeshop.ir,admin.vybeshop.ir

# --- Database (Postgres) ---
# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below — the `db`
# hostname is the Compose service name, resolved on the internal Docker
# network, not localhost.
DATABASE_URL=postgres://vybeshop:CHANGE_ME@db:5432/vybeshop
POSTGRES_DB=vybeshop
POSTGRES_USER=vybeshop
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (Celery broker/result backend + throttle cache) ---
REDIS_URL=redis://redis:6379/0

# --- CORS ---
# Only the storefront needs this — it's the one origin that calls
# api.vybeshop.ir cross-origin (it's hosted on Vercel, a different origin).
# admin.vybeshop.ir calls the API same-origin through its own Nginx proxy
# (see nginx/nginx.conf), so it doesn't need to be listed here.
# No trailing slashes.
CORS_ALLOWED_ORIGINS=https://vybeshop.ir,https://www.vybeshop.ir

# --- Payment-gateway callback URLs ---
# BACKEND_BASE_URL: where the payment gateway redirects after checkout,
# before Django bounces the browser back into the SPA. This is now the
# backend's own host (api.), not the storefront's.
# FRONTEND_BASE_URL: where that final bounce sends the browser — still the
# storefront the shopper is actually using, unaffected by where Django runs.
BACKEND_BASE_URL=https://api.vybeshop.ir
FRONTEND_BASE_URL=https://vybeshop.ir

# --- Encryption ---
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts ApiCredential rows (Kavenegar/Zarinpal keys) at rest. Losing this
# after credentials are saved means re-entering them all through the panel —
# back it up somewhere safe, separate from the database backup.
FIELD_ENCRYPTION_KEY=

# --- Do NOT set in production ---
# CELERY_TASK_ALWAYS_EAGER — dev/test-only override that runs Celery tasks
# inline instead of on a worker. Leaving it unset (the default: False
# outside `manage.py test`) is correct here.

# --- Backend image (Docker Hub, deploy/STAGE4-FIX-TASK.md) ---
# Not read by Django — only by deploy/setup.sh (docker login + `dc pull`) and
# docker-compose.prod.yml's DOCKERHUB_USER/BACKEND_IMAGE_TAG substitution.
#
# Originally pulled from GHCR; switched to Docker Hub after GHCR (behind
# Fastly) proved consistently unreachable from this server (TLS handshake
# timeouts on every attempt, even with retries) while Docker Hub worked
# immediately. See deploy/setup.sh stage 4.
#
# DOCKERHUB_TOKEN: a Docker Hub Access Token scoped to read-only (Account
# Settings -> Security -> New Access Token -> "Read-only"). The vybeshop-backend
# repo is private, so pulling its image needs auth even though the image name
# itself isn't secret. Never give this token write/delete access, and never
# commit it — this file is a template; the real .env.production is gitignored.
DOCKERHUB_TOKEN=
# The Docker Hub username that owns the token above (and the image
# namespace: ${DOCKERHUB_USER}/vybeshop-backend).
DOCKERHUB_USER=
# Which build to run. `latest` for convenience; pin to a specific
# `sha-<7-char>` tag (printed by the build-backend-image.yml workflow) for a
# deploy you may need to roll back — changing this one variable + `dc pull &&
# dc up -d` IS the rollback, no rebuild required.
BACKEND_IMAGE_TAG=latest

# --- Backups (deploy/backup.sh, DEPLOY-TASK.md §4) ---
# S3-compatible Object Storage for off-server backup uploads (Arvan Cloud
# Object Storage, Liara, or real AWS S3 -- anything speaking the S3 API).
# Not read by Django — only by deploy/backup.sh directly, and by
# deploy/setup.sh stage 7 (installs aws CLI + runs a real download+restore
# test against whatever's actually sitting in the bucket, not just the
# local copy, the moment these four are filled in). Leave unset to keep
# backups local-only (deploy/backup.sh will warn on every run; if the
# server is ever lost, everything since the last manual off-server copy
# is lost with it).
#
# BACKUP_S3_BUCKET: bucket name only, e.g. "vybeshop-backups" (not a URL).
# BACKUP_S3_ENDPOINT: the provider's S3 API endpoint, full https:// URL,
#   e.g. Arvan: https://s3.ir-thr-at1.arvanstorage.ir
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
